# Copy to frontend/.env and fill in. Never commit .env.

# URL of the deployed backend (no trailing slash).
# Local development default is http://localhost:8000
VITE_API_URL=http://localhost:8000

# Optional: override the map style URL. Defaults to OpenFreeMap positron
# (muted greyscale, no API key needed).
# VITE_MAP_STYLE=https://tiles.openfreemap.org/styles/positron
